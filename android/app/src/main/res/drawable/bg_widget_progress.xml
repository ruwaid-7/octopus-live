<?xml version="1.0" encoding="utf-8"?>
<!-- Electricity bar: green to amber to red (the app's levels) on a faint track -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/divider_subtle" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:angle="0"
                    android:centerColor="@color/elec_mid"
                    android:endColor="@color/elec_high"
                    android:startColor="@color/elec_low"
                    android:type="linear" />
            </shape>
        </scale>
    </item>
</layer-list>
