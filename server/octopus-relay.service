[Unit]
Description=Octopus Live relay (polls Octopus Energy once for all devices)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/octopus-relay.env
ExecStart=/usr/bin/python3 /opt/octopus-relay/octopus_relay.py
Restart=always
RestartSec=10
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
