    <string name="ob_opt_make_sub">For several devices or 10-second updates. About 5 minutes.</string>
    <string name="ob_choose_note">Not sure? Choose Just this phone. Most people don\'t need a relay.</string>
    <string name="ob_key_title">Add your API key</string>
    <string name="ob_key_body">Octopus gives every customer a personal API key. Copy it from your account and paste it here.</string>
    <string name="ob_key_open">Open Octopus to copy my key ↗</string>
    <string name="ob_key_private">Stays on this phone and is only sent to Octopus Energy.</string>
    <string name="ob_account_label">Account number (only if you have more than one)</string>
    <string name="ob_key_invalid">Octopus API keys start with sk_live_</string>
    <string name="ob_relay_title">Connect to your relay</string>
    <string name="ob_relay_body">On your relay\'s web page, tap Open in Octopus Live and this fills in by itself. Or paste the device link here.</string>
    <string name="ob_relay_label">Device link</string>
    <string name="ob_relay_help">Looks like https://…/?token=…</string>
    <string name="ob_relay_invalid">Paste the full link, starting with https://</string>
    <string name="ob_make_title">Make a free relay</string>
    <string name="ob_make_body">A relay runs on Cloudflare\'s free plan and shares your live usage with all your devices. Nothing to install.</string>
    <string name="ob_make_step1">Tap Open Cloudflare, sign in or make a free account, then tap Deploy. It may also ask you to sign in to GitHub.</string>
    <string name="ob_make_step2">When it\'s done, open the address it shows (ending in workers.dev). Paste your API key and choose a username and password.</string>
    <string name="ob_make_step3">Tap Open in Octopus Live on that page. This app fills itself in.</string>
    <string name="ob_make_open">Open Cloudflare ↗</string>
    <string name="ob_make_have_link">I already have the link</string>
    <string name="ob_make_later">Use just this phone for now</string>
