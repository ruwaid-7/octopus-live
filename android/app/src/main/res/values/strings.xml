    <string name="ob_alerts_body">Pick what you want to hear about. You can fine-tune levels later in Alerts.</string>
    <string name="ob_alert_high_sub">Above 3 kW for 45 minutes</string>
    <string name="ob_alerts_note">Costs, cheap prices and the daily summary need an API key.</string>
