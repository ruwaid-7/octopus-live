<?xml version="1.0" encoding="utf-8"?>
<!-- Warning banner: tinted, 1dp border, 4dp rail down the left edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tint_orange" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/gas_accent" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/gas_accent" />
            <corners android:topLeftRadius="10dp" android:bottomLeftRadius="10dp" />
        </shape>
    </item>
</layer-list>
