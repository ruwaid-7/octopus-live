<?xml version="1.0" encoding="utf-8"?>
<!-- Gas on, live: the flame morphs and breathes gently (3.6 s cycle). Design by Gemini. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:aapt="http://schemas.android.com/aapt"
android:drawable="@drawable/ic_gas_flame_on">
<!-- 1. OUTER PLUME PATH MORPH (3600ms cycle: KF1 Neutral -> KF2 Left Draft -> KF3 Right Draft -> KF1) -->
<!-- Node signature: M c1 c2 c3 c4 c5 c6 Z (1 Move, 6 Cubic Beziers, 1 Close) -->
<target android:name="outer_path">
<aapt:attr name="android:animation">
<set android:ordering="together">
<objectAnimator
android:propertyName="pathData"
android:duration="3600"
android:repeatCount="infinite"
android:repeatMode="restart"
android:interpolator="@android:interpolator/accelerate_decelerate">
<propertyValuesHolder android:propertyName="pathData" android:valueType="pathType">
<!-- KF1 (0.00): Neutral laminar posture -->
<keyframe
android:fraction="0.0"
android:value="M 12.0,21.5 C 8.0,21.5 5.5,18.4 5.5,14.2 C 5.5,9.6 9.8,5.8 12.2,2.2 C 13.0,5.2 13.8,6.8 13.4,8.6 C 14.8,7.5 15.6,6.1 15.8,4.8 C 17.6,7.6 18.5,10.9 18.5,14.2 C 18.5,18.4 16.0,21.5 12.0,21.5 Z" />
<!-- KF2 (0.35): Subtle thermal draft left & taller (+0.4dp height) -->
<keyframe
android:fraction="0.35"
android:value="M 12.0,21.5 C 7.9,21.5 5.4,18.3 5.4,14.0 C 5.4,9.3 9.4,5.5 11.7,1.8 C 12.6,4.9 13.5,6.6 13.2,8.4 C 14.5,7.3 15.3,5.9 15.5,4.5 C 17.4,7.4 18.4,10.8 18.4,14.1 C 18.4,18.3 16.0,21.5 12.0,21.5 Z" />
<!-- KF3 (0.70): Subtle settling right & slightly compressed (-0.3dp height) -->
<keyframe
android:fraction="0.7"
android:value="M 12.0,21.5 C 8.1,21.5 5.6,18.5 5.6,14.4 C 5.6,9.8 10.2,6.0 12.6,2.5 C 13.3,5.4 14.0,7.0 13.6,8.8 C 15.0,7.7 15.9,6.4 16.1,5.1 C 17.8,7.8 18.6,11.0 18.6,14.3 C 18.6,18.5 16.1,21.5 12.0,21.5 Z" />
<!-- KF1 (1.00): Return smoothly to neutral -->
<keyframe
android:fraction="1.0"
android:value="M 12.0,21.5 C 8.0,21.5 5.5,18.4 5.5,14.2 C 5.5,9.6 9.8,5.8 12.2,2.2 C 13.0,5.2 13.8,6.8 13.4,8.6 C 14.8,7.5 15.6,6.1 15.8,4.8 C 17.6,7.6 18.5,10.9 18.5,14.2 C 18.5,18.4 16.0,21.5 12.0,21.5 Z" />
</propertyValuesHolder>
</objectAnimator>
<!-- Outer Plume Opacity Breathing: 0.28 -> 0.36 -> 0.28 -->
<objectAnimator
android:propertyName="fillAlpha"
android:duration="1800"
android:valueFrom="0.28"
android:valueTo="0.36"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
</aapt:attr>
</target>
<!-- 2. INNER CORE PATH MORPH (3600ms cycle) -->
<!-- Node signature: M c1 c2 c3 c4 Z (1 Move, 4 Cubic Beziers, 1 Close) -->
<target android:name="inner_path">
<aapt:attr name="android:animation">
<set android:ordering="together">
<objectAnimator
android:propertyName="pathData"
android:duration="3600"
android:repeatCount="infinite"
android:repeatMode="restart"
android:interpolator="@android:interpolator/accelerate_decelerate">
<propertyValuesHolder android:propertyName="pathData" android:valueType="pathType">
<!-- KF1 (0.00): Neutral core -->
<keyframe
android:fraction="0.0"
android:value="M 12.0,21.0 C 9.6,21.0 8.2,19.0 8.2,16.2 C 8.2,13.2 10.4,10.8 12.1,8.2 C 13.6,10.8 15.8,13.2 15.8,16.2 C 15.8,19.0 14.4,21.0 12.0,21.0 Z" />
<!-- KF2 (0.35): Counter-lean slightly right while outer leans left -->
<keyframe
android:fraction="0.35"
android:value="M 12.0,21.0 C 9.5,21.0 8.1,18.9 8.1,16.0 C 8.1,13.0 10.6,10.5 12.3,7.8 C 13.8,10.5 15.9,13.0 15.9,16.0 C 15.9,18.9 14.5,21.0 12.0,21.0 Z" />
<!-- KF3 (0.70): Settle slightly lower and wider -->
<keyframe
android:fraction="0.7"
android:value="M 12.0,21.0 C 9.7,21.0 8.3,19.1 8.3,16.4 C 8.3,13.5 10.2,11.1 11.8,8.6 C 13.4,11.1 15.7,13.5 15.7,16.4 C 15.7,19.1 14.3,21.0 12.0,21.0 Z" />
<!-- KF1 (1.00): Return to neutral -->
<keyframe
android:fraction="1.0"
android:value="M 12.0,21.0 C 9.6,21.0 8.2,19.0 8.2,16.2 C 8.2,13.2 10.4,10.8 12.1,8.2 C 13.6,10.8 15.8,13.2 15.8,16.2 C 15.8,19.0 14.4,21.0 12.0,21.0 Z" />
</propertyValuesHolder>
</objectAnimator>
<!-- Inner Core Opacity Pulse: 1.0 -> 0.88 -> 1.0 -->
<objectAnimator
android:propertyName="fillAlpha"
android:duration="1400"
android:valueFrom="1.0"
android:valueTo="0.88"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
</aapt:attr>
</target>
<!-- 3. SUBTLE GROUP SCALE/ROTATION (Can also be used standalone in Jetpack Compose) -->
<target android:name="outer_group">
<aapt:attr name="android:animation">
<set android:ordering="together">
<objectAnimator
android:propertyName="scaleY"
android:duration="1800"
android:valueFrom="1.0"
android:valueTo="1.035"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
<objectAnimator
android:propertyName="scaleX"
android:duration="1800"
android:valueFrom="1.0"
android:valueTo="0.98"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
<objectAnimator
android:propertyName="rotation"
android:duration="2700"
android:valueFrom="-1.2"
android:valueTo="1.5"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
</aapt:attr>
</target>
<target android:name="inner_group">
<aapt:attr name="android:animation">
<set android:ordering="together">
<objectAnimator
android:propertyName="scaleY"
android:duration="1400"
android:valueFrom="1.0"
android:valueTo="0.965"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
<objectAnimator
android:propertyName="rotation"
android:duration="2100"
android:valueFrom="1.0"
android:valueTo="-1.0"
android:valueType="floatType"
android:repeatCount="infinite"
android:repeatMode="reverse"
android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
</aapt:attr>
</target>
</animated-vector>
