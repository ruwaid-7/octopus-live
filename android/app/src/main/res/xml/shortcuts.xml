<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: open the meter display straight away -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="meter_display"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_meter"
        android:shortcutShortLabel="@string/md_open"
        android:shortcutLongLabel="@string/md_open_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="uk.octopuslive.app"
            android:targetClass="uk.octopuslive.MeterDisplayActivity" />
    </shortcut>
</shortcuts>
