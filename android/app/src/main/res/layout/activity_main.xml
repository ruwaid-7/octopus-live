<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- 1. Brand Header: App Title & Tagline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Brand Accent Pill Indicator -->
            <View
                android:layout_width="6dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_brand_pill" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    tools:text="Octopus Live" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="Real-time Home Mini electricity monitor" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <!-- 2. Hero Status Card (Latest Reading) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_live_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="LATEST READING"
                    android:textColor="@color/brand_pink"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/status_card_text"
                android:textSize="16sp"
                tools:text="1.24 kW\nToday: 5.23 kWh\nMeter reading at 18:05" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <!-- Costs & history -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/history_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/insightsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/insights_waiting"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/chart_today"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <uk.octopuslive.BarChartView
                android:id="@+id/chartToday"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/chart_week"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <uk.octopuslive.BarChartView
                android:id="@+id/chartWeek"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/weekText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <!-- 3. Main Configuration Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- API Key Field -->
            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/apiKey"
                android:text="@string/api_key"
                tools:text="Octopus API Key" />

            <EditText
                android:id="@+id/apiKey"
                android:hint="sk_live_…"
                style="@style/InputField"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                tools:text="sk_live_1234567890abcdef" />

            <!-- Link-style helper text -->
            <TextView
                android:id="@+id/getKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/get_key"
                android:textColor="@color/brand_pink"
                android:textSize="13sp"
                tools:text="Where do I find my API key? →" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider_subtle" />

            <!-- Account Number Field (Optional) -->
            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/account"
                android:text="@string/account"
                tools:text="Account Number (optional)" />

            <EditText
                android:id="@+id/account"
                android:hint="A-1234ABCD"
                style="@style/InputField"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                tools:text="A-AAAA1111" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider_subtle" />

            <!-- Home server (relay) address, optional -->
            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/relayUrl"
                android:text="@string/relay_label" />

            <EditText
                android:id="@+id/relayUrl"
                android:hint="http://192.168.1.50:8765"
                style="@style/InputField"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/relay_help"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider_subtle" />

            <!-- Refresh Interval Field (Seconds) -->
            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/interval"
                android:text="@string/interval"
                tools:text="Refresh interval (seconds)" />

            <EditText
                android:id="@+id/interval"
                style="@style/InputField"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1"
                tools:text="30" />

            <!-- Auto-Start Checkbox -->
            <CheckBox
                android:id="@+id/boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="@color/brand_pink"
                android:fontFamily="sans-serif"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="@string/start_on_boot"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Start automatically after the phone restarts" />

            <!-- Widget tap -->
            <CheckBox
                android:id="@+id/widgetOpensApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_pink"
                android:fontFamily="sans-serif"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="@string/widget_opens_app"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Gas warning -->
            <CheckBox
                android:id="@+id/gasAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/brand_pink"
                android:fontFamily="sans-serif"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="@string/gas_alert"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="38dp"
                android:text="@string/gas_alert_help"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <!-- Alerts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/alerts_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/highAlert"
                style="@style/AlertCheck"
                android:text="@string/high_alert" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="38dp">

                <EditText
                    android:id="@+id/highKw"
                    style="@style/InputField"
                    android:layout_width="72dp"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/kw_for"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/highMinutes"
                    style="@style/InputField"
                    android:layout_width="72dp"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/minutes"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/offlineAlert"
                style="@style/AlertCheck"
                android:layout_marginTop="8dp"
                android:text="@string/offline_alert" />

            <CheckBox
                android:id="@+id/cheapAlert"
                style="@style/AlertCheck"
                android:layout_marginTop="8dp"
                android:text="@string/cheap_alert" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="38dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/at_or_below"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/cheapPence"
                    style="@style/InputField"
                    android:layout_width="80dp"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/pence_kwh"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/summaryAlert"
                style="@style/AlertCheck"
                android:layout_marginTop="8dp"
                android:text="@string/summary_alert" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="38dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/at_hour"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/summaryHour"
                    style="@style/InputField"
                    android:layout_width="72dp"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/oclock"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/alerts_help"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <!-- Background running -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/bg_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bg_help"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bgStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/bgBattery"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/bg_battery" />

            <Button
                android:id="@+id/bgUnused"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/bg_unused" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/bg_samsung"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <!-- 4. Action Buttons Row (Side by Side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.3"
                android:text="@string/save_start"
                tools:text="Save &amp; start" />

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/stop"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/stop"
                tools:text="Stop" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 5. Privacy & Rate Limits Footnote -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/footnote"
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="Your API key is stored locally on your device and communicates directly with Octopus Energy GraphQL servers. Keep your refresh interval reasonable to respect Home Mini rate limits." />

    </LinearLayout>
</ScrollView>