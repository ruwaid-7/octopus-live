<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Unfilled Track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/octopus_progress_track" />
        </shape>
    </item>

    <!-- Filled Progress (Smooth Gradient from Low -> Medium -> High demand) -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:angle="0"
                    android:centerColor="@color/power_Normal_Amber"
                    android:endColor="@color/power_High_Red"
                    android:startColor="@color/power_Low_Green"
                    android:type="linear" />
            </shape>
        </scale>
    </item>
</layer-list>