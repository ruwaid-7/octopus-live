# Octopus Live relay settings. The installer copies this to /etc/octopus-relay.env
# (readable only by root and the service). After editing:  sudo systemctl restart octopus-relay
#
# You don't need to put your API key or token here: open the relay's web page and set it up
# there. These two are only read on the very first start (for older installs).

# Your Octopus API key (starts with sk_live_). Optional - use the web page instead.
OCTOPUS_API_KEY=

# Optional: account number, e.g. A-1234ABCD. Leave blank to detect automatically.
OCTOPUS_ACCOUNT=

# Seconds between electricity readings (minimum 30). Each poll is one request; today's total
# is re-checked every 30 min and gas every 30 min on top. 60 = about 64 requests/hour, safely
# under Octopus's limit (~100/hour, shared by everything using your API key).
POLL_SECONDS=60

# Port the relay listens on.
RELAY_PORT=8765

# Shared secret. Devices add ?token=YOURSECRET to the server address. Optional - the web page
# creates one for you when you set it up.
RELAY_TOKEN=

# Time zone used to decide when "today" starts.
TZ=Europe/London
