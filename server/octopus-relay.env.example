# Octopus Live relay settings. The installer copies this to /etc/octopus-relay.env
# (readable only by root and the service). After editing:  sudo systemctl restart octopus-relay

# Your Octopus API key (starts with sk_live_). Required.
OCTOPUS_API_KEY=

# Optional: account number, e.g. A-1234ABCD. Leave blank to detect automatically.
OCTOPUS_ACCOUNT=

# Seconds between electricity readings (minimum 30). 45 = about 80 requests/hour,
# safely under Octopus's ~100/hour limit. Gas is fetched every 30 minutes on top.
POLL_SECONDS=45

# Port the relay listens on.
RELAY_PORT=8765

# Shared secret. Devices add ?token=YOURSECRET to the server address. install.sh generates one
# automatically. Required if you publish the relay on the internet (e.g. a Cloudflare tunnel).
RELAY_TOKEN=

# Time zone used to decide when "today" starts.
TZ=Europe/London
